# Expo + Metro require a hoisted node_modules layout to resolve React Native
# packages correctly under pnpm.
node-linker=hoisted

# NOTE: TLS settings (e.g. strict-ssl) are intentionally NOT set here so they
# stay out of version control. On NBC's corporate network you must either:
#   1) point npm at the Fortinet CA:  npm config set cafile "C:\path\corp-ca.pem"
#   2) or relax verification per-user: npm config set strict-ssl false --location=user
# See docs/SETUP.md ("Corporate network / firewall").
