{
  // Settings for a development machine only.
  "ConnectionStrings": {
    // SQL Server on this machine, signed in as the current Windows user. TrustServerCertificate
    // accepts the self-signed certificate a local SQL Server uses. Never use it against a real server.
    "Pbrms": "Server=localhost;Database=PBRMS;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Auth": {
    // "Development" = sign in with POST /auth/dev-login, no password. See Auth/SignIn.cs.
    "Mode": "Development"
  },
  "Database": {
    // Create/update the database and add sample people when the API starts.
    "PrepareOnStartup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
