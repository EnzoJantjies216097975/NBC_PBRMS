{
  // Settings for NBC's servers. appsettings.Development.json overrides them on a development machine.
  // Real values (connection string, tenant and client ids) are set on the server, not committed here.
  "ConnectionStrings": {
    "Pbrms": ""
  },
  "Auth": {
    // "Microsoft" = sign in with NBC email through Entra ID. See Auth/SignIn.cs.
    "Mode": "Microsoft",
    "Microsoft": {
      "TenantId": "",
      "ClientId": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
