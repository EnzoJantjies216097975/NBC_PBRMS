@* The daily roster for any day. Everyone can read it; the Booking Officer can add the
   announcement and print it. It refreshes by itself as bookings are confirmed. *@
@page "/daily-roster"
@implements IDisposable
@inject ApiClient Api
@inject LiveUpdates Live
@inject IJSRuntime Browser

<PageTitle>Daily roster</PageTitle>

<h1>Daily roster</h1>

<div class="actions">
    <input type="date" value="@date.ToString("yyyy-MM-dd")" @onchange="ChangeDateAsync" />
    @if (Api.Has(Role.BookingOfficer))
    {
        <button @onclick="PrintAsync">Download A4 PDF</button>
    }
</div>

@if (error is not null)
{
    <p class="error">@error</p>
}

@if (roster is not null)
{
    @if (Api.Has(Role.BookingOfficer))
    {
        <div class="actions">
            <input class="wide" @bind="announcement" placeholder="Announcement for the top of the sheet" />
            <button class="quiet" @onclick="SaveAnnouncementAsync">Save</button>
        </div>
    }
    else if (roster.Announcement is not null)
    {
        <p><strong>@roster.Announcement</strong></p>
    }

    var trades = roster.Lines.SelectMany(l => l.Crew).Select(c => c.Division).Distinct().Order().ToList();

    <table>
        <thead>
            <tr>
                <th>Area</th>
                <th>Time</th>
                <th>Production</th>
                @foreach (var trade in trades)
                {
                    <th>@trade</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var line in roster.Lines)
            {
                <tr>
                    <td><strong>@line.Area</strong></td>
                    <td>@Formats.Hours(line.StartsAt, line.EndsAt)</td>
                    <td>
                        @line.Title
                        @if (line.Detail is not null)
                        {
                            <div class="muted">@line.Detail</div>
                        }
                    </td>
                    @foreach (var trade in trades)
                    {
                        <td>
                            @foreach (var person in line.Crew.Where(c => c.Division == trade))
                            {
                                <div>@person.Name</div>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>

    @if (roster.Undecided.Count > 0)
    {
        <h2>Not confirmed yet</h2>
        <ul class="rows">
            @foreach (var booking in roster.Undecided)
            {
                <li>
                    <a href="bookings/@booking.BookingId">
                        <span class="title">#@booking.ProductionNo @booking.Title</span>
                        <span class="muted">@Formats.When(booking.StartsAt)</span>
                        @if (booking.OpenPositions.Count > 0)
                        {
                            <span class="muted">needs @string.Join(", ", booking.OpenPositions)</span>
                        }
                    </a>
                </li>
            }
        </ul>
    }
}

@code {
    private DateOnly date = DateOnly.FromDateTime(DateTime.Today.AddDays(1));
    private DailyRosterView? roster;
    private string? announcement, error;

    protected override async Task OnInitializedAsync()
    {
        Live.Changed += ReloadAsync;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.DailyRosterAsync(date);
        roster = result.Value;
        error = result.Error;
        announcement = roster?.Announcement;
    }

    private async Task ChangeDateAsync(ChangeEventArgs change)
    {
        if (DateOnly.TryParse(change.Value?.ToString(), out var picked))
        {
            date = picked;
            await LoadAsync();
        }
    }

    private async Task SaveAnnouncementAsync()
    {
        var result = await Api.SetAnnouncementAsync(date, announcement);
        error = result.Error;
        roster = result.Value ?? roster;
    }

    private async Task PrintAsync()
    {
        var pdf = await Api.DailyRosterPdfAsync(date);
        if (pdf is null)
        {
            error = "The printout couldn't be made.";
            return;
        }

        var name = $"Roster_{date.ToString("ddd_ddMMyyyy", System.Globalization.CultureInfo.InvariantCulture)}.pdf";
        await Browser.InvokeVoidAsync("saveFile", name, Convert.ToBase64String(pdf));
    }

    private Task ReloadAsync() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Live.Changed -= ReloadAsync;
}
