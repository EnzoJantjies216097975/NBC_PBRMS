@* One booking: its details, crew and history, and the next step for whoever is looking at it.
   The buttons here are a convenience. The API decides what each person may really do. *@
@page "/bookings/{Id:guid}"
@implements IDisposable
@inject ApiClient Api
@inject LiveUpdates Live

<PageTitle>Booking</PageTitle>

@if (booking is null)
{
    <p>@(error ?? "Loading…")</p>
}
else
{
    <h1>#@booking.ProductionNo @booking.Title</h1>
    <p>
        <span class="@Formats.StatusClass(booking.Status)">@Formats.Status(booking.Status)</span>
        <span class="muted">@booking.Department, @booking.Producer</span>
    </p>
    <p>@Formats.When(booking.StartsAt) to @Formats.Clock(booking.EndsAt), @Formats.Venue(booking.Venue) @booking.VenueText</p>

    @if (booking.DepartureMissedAt is not null)
    {
        <p class="problem">Nobody has confirmed this shoot left. Phone the producer: if it didn't go, cancel the booking to release its crew.</p>
    }
    @if (booking.DepartedAt is { } left)
    {
        <p class="muted">Left at @Formats.Clock(left)</p>
    }

    <h2>Crew</h2>
    <table>
        <thead>
            <tr>
                <th>Position</th><th>Division</th><th>Operator</th>
                @if (isOnTheDay)
                {
                    <th>On the day</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var slot in booking.CrewSlots)
            {
                <tr>
                    <td>@slot.PositionLabel</td>
                    <td>@slot.Division</td>
                    <td>
                        @if (canChooseCrew && pickers.TryGetValue(slot.DivisionId, out var operators))
                        {
                            <select @onchange="e => Choose(slot.Id, e.Value?.ToString())">
                                <option value="">Choose…</option>
                                @foreach (var person in operators)
                                {
                                    <option value="@person.Id" selected="@(slot.OperatorId == person.Id)">@person.Name</option>
                                }
                            </select>
                        }
                        else
                        {
                            @(slot.Operator ?? "Not filled")
                        }
                        @if (slot.OperatorPhone is not null)
                        {
                            <span class="muted"> @slot.OperatorPhone</span>
                        }
                    </td>
                    @if (isOnTheDay)
                    {
                        <td class="on-the-day">
                            @if (slot.ArrivedAt is { } arrived)
                            {
                                <span class="badge good">Arrived @Formats.Clock(arrived)</span>
                                @if (isProducer)
                                {
                                    <button class="quiet" @onclick="() => MarkArrivalAsync(slot.Id, false)" aria-label="Undo arrival of @slot.Operator">Undo</button>
                                }
                            }
                            else
                            {
                                @if (isProducer)
                                {
                                    <button @onclick="() => MarkArrivalAsync(slot.Id, true)" aria-label="Mark @slot.Operator as arrived">Arrived</button>
                                    <button class="danger" @onclick="() => SignalAsync(slot.Id)" aria-label="Signal @slot.Operator">Signal</button>
                                }
                                @if (slot.SignalledAt is { } signalled)
                                {
                                    <span class="badge wait">Signalled @Formats.Clock(signalled)</span>
                                }
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>

    @if (chosen.Count > 0)
    {
        <p><button @onclick="() => SaveCrewAsync(false)">Save crew</button></p>
    }

    @if (error is not null)
    {
        <div class="problem">
            <p>@error</p>
            @if (clashes.Count > 0)
            {
                <ul>
                    @foreach (var clash in clashes)
                    {
                        <li>@Formats.Clash(clash)</li>
                    }
                </ul>
            }
            @if (warningFor is not null)
            {
                <button @onclick="GoAheadAsync">Go ahead anyway</button>
            }
            @if (canOverrideStudios)
            {
                <p><input @bind="reason" placeholder="Why this can't wait" /></p>
                <button @onclick="() => SaveCrewAsync(false)">Override with this reason</button>
            }
        </div>
    }

    <h2>Next step</h2>
    <div class="actions">
        @if (booking.Status == BookingStatus.Draft && Api.Me!.Id == booking.ProducerId)
        {
            <a class="button quiet" href="bookings/@booking.Id/edit">Edit</a>
            <button @onclick="() => MoveAsync(BookingAction.Submit)">Submit to the EP</button>
        }
        @if (booking.Status == BookingStatus.Draft && Api.Has(Role.BookingOfficer))
        {
            <button class="quiet" @onclick="AllowLateAsync">Allow after the cut-off</button>
        }
        @if (booking.Status == BookingStatus.EpReview && Api.Has(Role.ExecutiveProducer))
        {
            <select @bind="channel">
                <option value="">No channel</option>
                @foreach (var value in Enum.GetValues<Channel>())
                {
                    <option value="@value">@value</option>
                }
            </select>
            <button @onclick="() => MoveAsync(BookingAction.Approve)">Approve</button>
        }
        @if (booking.Status == BookingStatus.Finalisation && Api.Has(Role.BookingOfficer))
        {
            <button @onclick="() => MoveAsync(BookingAction.Approve)">Confirm</button>
        }
        @if (booking.Status == BookingStatus.Confirmed && isProducer && booking.LeavesTheBuilding && booking.DepartedAt is null)
        {
            <button class="quiet" @onclick="MarkDepartedAsync">Crew has left</button>
        }
        @if (booking.Status == BookingStatus.Confirmed && Api.Me!.Id == booking.ProducerId)
        {
            <button @onclick="() => MoveAsync(BookingAction.Start)">Production has started</button>
        }
        @if (booking.Status == BookingStatus.InProgress && Api.Me!.Id == booking.ProducerId)
        {
            <button @onclick="() => MoveAsync(BookingAction.End)">Production has ended</button>
        }
    </div>

    @if (booking.Status is not (BookingStatus.Completed or BookingStatus.Cancelled))
    {
        <div class="actions">
            <input class="wide" @bind="note" placeholder="Reason, to send back or cancel" />
            @if (booking.Status is BookingStatus.EpReview or BookingStatus.CrewAssignment)
            {
                <button class="quiet" @onclick="() => MoveAsync(BookingAction.SendBack)">Send back</button>
            }
            <button class="danger" @onclick="() => MoveAsync(BookingAction.Cancel)">Cancel booking</button>
        </div>
    }

    <h2>History</h2>
    <ul class="history">
        @foreach (var change in booking.History)
        {
            <li>
                <span class="muted">@Formats.When(change.At)</span>
                @change.By: @Formats.Status(change.To)
                @if (change.Note is not null)
                {
                    <em> "@change.Note"</em>
                }
            </li>
        }
    </ul>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private BookingResponse? booking;
    private readonly Dictionary<Guid, List<OperatorRow>> pickers = [];
    private readonly Dictionary<Guid, Guid?> chosen = [];
    private bool canChooseCrew;
    private string? error, note, reason;
    private string channel = "";
    private List<Clash> clashes = [];
    private Func<Task>? warningFor;
    private bool canOverrideStudios;

    // The producer works this booking on the day: everyone else just sees how it's going.
    private bool isProducer => booking?.ProducerId == Api.Me?.Id;
    private bool isOnTheDay => booking?.Status is BookingStatus.Confirmed or BookingStatus.InProgress;

    protected override async Task OnInitializedAsync()
    {
        Live.Changed += ReloadAsync;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var result = await Api.BookingAsync(Id);
        booking = result.Value;
        if (booking is null)
        {
            error = result.Error ?? "You can't open this booking.";
            return;
        }

        canChooseCrew = booking.Status is BookingStatus.CrewAssignment or BookingStatus.Finalisation or BookingStatus.Confirmed
                        && Api.Has(Role.Supervisor, Role.BookingOfficer);

        if (canChooseCrew)
        {
            foreach (var division in booking.CrewSlots.Select(s => s.DivisionId).Distinct().Where(d => !pickers.ContainsKey(d)))
                pickers[division] = (await Api.OperatorsAsync(division)).Value ?? [];
        }
    }

    private void Choose(Guid slotId, string? value) =>
        chosen[slotId] = Guid.TryParse(value, out var operatorId) ? operatorId : null;

    private async Task SaveCrewAsync(bool acknowledge)
    {
        var changes = chosen.Select(c => new CrewChange(c.Key, c.Value)).ToList();
        Show(await Api.SaveCrewAsync(Id, new CrewRequest(changes, acknowledge, reason)), () => SaveCrewAsync(true));
    }

    private async Task MoveAsync(BookingAction action, bool acknowledge = false)
    {
        var picked = Enum.TryParse<Channel>(channel, out var value) ? value : (Channel?)null;
        var request = new TransitionRequest(action, note, picked, null, acknowledge);
        Show(await Api.TransitionAsync(Id, request), () => MoveAsync(action, true));
    }

    private async Task AllowLateAsync() => Show(await Api.AllowLateAsync(Id, note ?? ""), null);

    private async Task MarkArrivalAsync(Guid slotId, bool arrived) => Show(await Api.MarkArrivalAsync(Id, slotId, arrived), null);

    private async Task SignalAsync(Guid slotId) => Show(await Api.SignalAsync(Id, slotId), null);

    private async Task MarkDepartedAsync() => Show(await Api.MarkDepartedAsync(Id), null);

    private Task GoAheadAsync() => warningFor?.Invoke() ?? Task.CompletedTask;

    /// <summary>Shows what the API said: the updated booking, or why not, with anything to acknowledge.</summary>
    private void Show(ApiResult<BookingResponse> result, Func<Task>? ifAcknowledged)
    {
        error = result.Error;
        clashes = result.Clashes;
        warningFor = result.NeedsAcknowledgement ? ifAcknowledged : null;
        canOverrideStudios = !result.Ok
                             && Api.Has(Role.BookingOfficer)
                             && clashes.Count > 0
                             && clashes.All(c => c.Kind == ClashKind.StudioNeedsCrew);

        if (!result.Ok)
            return;

        booking = result.Value;
        chosen.Clear();
        note = reason = null;
    }

    private Task ReloadAsync() => InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Live.Changed -= ReloadAsync;
}
