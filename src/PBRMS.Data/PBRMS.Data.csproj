<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PBRMS.Domain\PBRMS.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <!-- Not used directly. SqlServer pulls in version 9.0.11 of this package, which has known
         security holes (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Naming the fixed version here
         makes every project use it. Remove once SqlServer depends on a fixed version itself. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
